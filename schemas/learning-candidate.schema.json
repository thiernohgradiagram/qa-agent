{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-candidate.schema.json",
  "title": "Quote Knowledge Learning Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "runId",
    "scope",
    "change",
    "evidence",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "candidateId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "change": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiredReview": {
      "type": "string",
      "enum": [
        "none",
        "automation-owner",
        "business-owner",
        "security"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "validated",
        "approved",
        "rejected",
        "promoted"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
