{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-plan.schema.json",
  "title": "Quote Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "environment",
    "product",
    "jurisdiction",
    "scenario",
    "objectives",
    "assertions",
    "mutationLevel",
    "allowedOrigins"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopAt",
        "screenshots"
      ],
      "properties": {
        "stopAt": {
          "type": "string",
          "minLength": 1
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completeThrough": {
          "type": "string"
        },
        "expectedOutcome": {
          "type": "string"
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mutationLevel": {
      "type": "string",
      "enum": [
        "read_only",
        "quote_create",
        "quote_bind"
      ]
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "authProfile": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
